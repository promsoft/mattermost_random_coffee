# URL сервера Mattermost (полный, со схемой)
MM_URL=https://mm.example.com

# Токен bot-аккаунта (см. README — «Создание bot-аккаунта»)
MM_BOT_TOKEN=

# Канал для анонсов: ID канала (канал → View Info → ID). Пусто — анонсы выключены
ANNOUNCE_CHANNEL_ID=

# Админы бота (имена через запятую, без @)
ADMIN_USERNAMES=

# URL, по которому сервер Mattermost достучится до бота (кнопки).
# Бот и MM на одном хосте: http://127.0.0.1:9000 (или адрес docker-сети)
ACTIONS_BASE_URL=http://127.0.0.1:9000

# Обязательный секрет в URL кнопок. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ACTIONS_SECRET=

# Где слушает HTTP-эндпоинт кнопок (в Docker задаётся в compose)
HTTP_HOST=127.0.0.1
HTTP_PORT=9000
# Хост-порт публикации эндпоинта в docker compose (поменяйте, если 9000 занят)
HTTP_PUBLISH_PORT=9000

# Расписания: день недели (0 = понедельник) и время в поясе TZ
MATCH_WEEKDAY=0        # матчинг пар (пн 07:00)
MATCH_HOUR=7
MATCH_MINUTE=0
MIDWEEK_WEEKDAY=2      # опрос статуса (ср 14:00)
MIDWEEK_HOUR=14
MIDWEEK_MINUTE=0
SURVEY_WEEKDAY=6       # итоги и оценка (вс 14:00)
SURVEY_HOUR=14
SURVEY_MINUTE=0

# Путь к файлу SQLite (в Docker задаётся через compose: /data/coffee.db)
DB_PATH=coffee.db

LOG_LEVEL=INFO
TZ=Europe/Moscow
